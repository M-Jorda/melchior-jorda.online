# Configuration du publieur Dev Digest.
# Copier vers ~/.config/blog-digest/config.env puis : chmod 600 ~/.config/blog-digest/config.env
# Ce fichier contient des secrets : ne jamais le commiter.

# --- Boîte mail qui reçoit les digests (Gmail, mot de passe d'application) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=dev.digest.mel@gmail.com
IMAP_PASSWORD=
# Vide = dossier « Tous les messages » détecté automatiquement (recommandé).
IMAP_MAILBOX=
# Expéditeur des digests (filtre supplémentaire, facultatif).
DIGEST_FROM=jorda.j.fr@gmail.com

# --- Calendrier ---
TIMEZONE=Europe/Madrid
# Heure à partir de laquelle l'article du jour est publié (le digest arrive vers 5 h 55
# et couvre les nouvelles de la veille). Un digest reçu après le run de cette heure-là
# n'est intégré que s'il arrive avant la publication.
PUBLISH_AFTER=07:00
# Nombre de jours rattrapés quand le PC est resté éteint.
LOOKBACK_DAYS=14
# Nombre minimal d'articles quotidiens pour publier le récapitulatif de la semaine.
WEEKLY_MIN_DAILIES=3

# --- Génération (Claude Code, abonnement en cours) ---
CLAUDE_BIN=claude
# Vide = modèle par défaut de Claude Code.
CLAUDE_MODEL=
CLAUDE_TIMEOUT_SECONDS=900

# --- Déploiement Firebase (compte de service, rôle Firebase Hosting Admin) ---
GOOGLE_APPLICATION_CREDENTIALS=/home/<user>/.config/blog-digest/firebase-sa.json
FIREBASE_PROJECT=melchior-75a9e
FIREBASE_BIN=firebase
DEPLOY=true

# --- Git (historique des articles sur GitHub) ---
GIT_COMMIT=true
GIT_PUSH=true
